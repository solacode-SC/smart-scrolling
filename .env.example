# ==========================================
# SocialHub Environment Configuration
# ==========================================

# Core Application Settings
NODE_ENV=development
APP_URL=http://localhost:9900
API_URL=http://localhost:9901
PORT=9901
WEB_PORT=9900
API_PORT=9901

# Database & Caching (Default development ports: PostgreSQL 9910, Redis 9911)
DATABASE_URL="postgresql://socialhub:socialhub_secret@localhost:9910/socialhub?schema=public"
REDIS_URL="redis://localhost:9911"

# Security & Sessions
# Generate with: openssl rand -base64 32
AUTH_SECRET="insecure-dev-auth-secret-replace-in-production-min-32-chars"
# Symmetric encryption key (32 bytes hex or base64) for provider credentials at rest
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Email Provider Configuration (JSON or SMTP string)
EMAIL_PROVIDER_CONFIG='{"provider":"console"}'

# Platform Credentials (Provided as connectors are configured)
YOUTUBE_API_KEY=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
X_API_KEY=""
X_API_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
