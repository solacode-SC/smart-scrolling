    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@socialhub/shared": "workspace:*"
  },
  "devDependencies": {
    "@socialhub/config": "workspace:*",
    "@types/node": "^22.13.9",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}

