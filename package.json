{
  "name": "socialhub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build && pnpm -r --filter=./apps/* run build && pnpm -r --filter=./workers/* run build",
    "dev": "pnpm --parallel run dev",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:unit": "pnpm -r run test:unit",
    "test:integration": "pnpm -r run test:integration",
    "db:generate": "pnpm --filter @socialhub/database db:generate",
    "db:migrate": "pnpm --filter @socialhub/database db:migrate",
    "db:seed": "pnpm --filter @socialhub/database db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3"
  }
}
